# Nginx da Central de Atendimento Grupo LRI: dois listeners, só em 127.0.0.1, alcançados apenas pelo cloudflared
# que roda no mesmo namespace de rede (docs/lri/PLANO.md, seção 2.9.2). Renderizado na partida por
# contrib/lri/deploy/nginx-entrypoint.sh; os marcadores @...@ vêm do ambiente.

# proxy_pass com variável: o nome do container é resolvido a cada requisição (resolver em conf.d/resolver.conf), como
# o entrypoint oficial do Zammad faz, para seguir o container recriado com outro IP.

# Troca exata de Origin no WebSocket (issue #2): o texto inteiro, sem curinga. Usa expressão ancorada (^...$) com
# os pontos escapados porque, no map do Nginx, comparação de texto simples ignora maiúsculas; a expressão com "~"
# diferencia. Qualquer outro valor passa como veio e o Zammad recusa.
map $http_origin $lri_internal_ws_origin {
  default                            $http_origin;
  "~^https://@INTERNAL_HOST_RE@$"    "https://@FQDN@";
}

map $http_origin $lri_public_ws_origin {
  default                            $http_origin;
  "~^https://@MW_HOST_RE@$"          "https://@FQDN@";
}

# Monitor externo: o token de monitoramento do Zammad vem só no cabeçalho X-LRI-Monitor-Token, no formato que o
# Zammad gera; qualquer outro valor vira vazio (o Zammad recusa). Fora da URL, ele não fica nos logs da borda nem
# nos do Nginx; o log de acesso dessa rota grava o caminho sem a query.
map $http_x_lri_monitor_token $lri_monitor_token {
  default                       "";
  "~^[A-Za-z0-9_-]{20,128}$"    $http_x_lri_monitor_token;
}

# Caminho ambíguo no nome interno: barra, contrabarra ou ponto codificados, ou segmento "." / ".." (delimitado por
# barra literal ou codificada), só na parte do caminho (a query não conta). A borda escolhe o aplicativo do Access pelo caminho normalizado, mas entrega o
# endereço cru, e o Nginx o decodifica de novo antes de escolher a location. Com esses caracteres, as duas leituras
# divergem: um pedido que o Access casou com o aplicativo do monitor (que vale por prefixo) sairia do prefixo aqui e
# chegaria a outra rota do Zammad. Navegador não manda ponto codificado nem segmento "."/".." no caminho; barra
# codificada só aparece nas rotas das interfaces /desktop/ e /mobile/ (a busca põe o termo no caminho, ex.: um número
# de pedido com barra). Ali ela é aceita: sem segmento "..", o caminho normalizado continua sob /desktop/ ou /mobile/
# e não alcança o aplicativo do monitor. A ordem das linhas importa (vale a primeira expressão que casar).
map $request_uri $lri_caminho_ambiguo {
  default                              0;
  "~*^[^?]*(%2e|(/|%2f|%5c)\.\.?(/|%2f|%5c|\?|$))"  1;
  "~^/(desktop|mobile)/"               0;
  "~*^[^?]*(%2f|%5c)"                  1;
}

log_format lri_sem_query '$remote_addr - [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

# O IP real do cliente vem da Cloudflare; só o cloudflared (127.0.0.1) é confiável para informá-lo.
set_real_ip_from 127.0.0.1;
real_ip_header CF-Connecting-IP;

underscores_in_headers off;
ignore_invalid_headers on;
# server_tokens fica em cada server, não aqui: o nginx.conf do Debian da imagem já o define no http, e repetir no
# mesmo nível faz o nginx -t recusar ("directive is duplicate"). No server vale mesmo com outro nginx.conf.

# ---------------------------------------------------------------------------------------------------------------
# ZONA PÚBLICA: suporte.lri.com.br, suporte.meanwellbrasil.com.br, suporte.ird.net.br
# ---------------------------------------------------------------------------------------------------------------
server {
  listen 127.0.0.1:8081 default_server;
  server_name _;
  server_tokens off;
  return 404;
}

server {
  listen 127.0.0.1:8081;
  server_name @PUBLIC_HOSTS@;
  server_tokens off;

  root /opt/zammad/public;
  access_log /dev/stdout;
  error_log  /dev/stdout;
  client_max_body_size @MAX_BODY@;

  error_page 403 /lri-bloqueio.html;
  location = /lri-bloqueio.html {
    internal;
    add_header Cache-Control "no-store" always;
    root /opt/zammad/contrib/lri/deploy/nginx;
  }

  # Retornos de OAuth da equipe chegam ao fqdn (registrado no Google e no Entra ID) e seguem para o nome interno:
  # caminho exato, destino fixo, query preservada. Nada do Host nem de parâmetros entra no destino.
  location = /auth/google_oauth2/callback              { return 302 https://@INTERNAL_HOST@$request_uri; }
  location = /auth/microsoft_office365/callback        { return 302 https://@INTERNAL_HOST@$request_uri; }
  location = /api/v1/external_credentials/google/callback          { return 302 https://@INTERNAL_HOST@$request_uri; }
  location = /api/v1/external_credentials/microsoft_graph/callback { return 302 https://@INTERNAL_HOST@$request_uri; }

  # Rotas da equipe: bloqueadas sem diferenciar maiúsculas (o OmniAuth também não diferencia). A guarda de zona no
  # Zammad recusa de novo; isto é defesa em profundidade.
  location ~* ^/(auth|oauth)(/|$)                        { return 403; }
  location ~* ^/api/v1/(external_credentials|monitoring)(/|$) { return 403; }
  location ~* ^/lri-monitor(/|$)                          { return 403; }

  location ~ ^/(assets/|robots.txt|humans.txt|favicon.ico|apple-touch-icon.png) {
    expires max;
  }

  location /ws {
    include /etc/nginx/lri/lri-zone-public.inc;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_set_header Origin $lri_public_ws_origin;
    proxy_read_timeout 86400;
    set $lri_websocket http://@WEBSOCKET_UPSTREAM@;
    proxy_pass $lri_websocket;
  }

  location /cable {
    include /etc/nginx/lri/lri-zone-public.inc;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_set_header Origin $lri_public_ws_origin;
    proxy_read_timeout 86400;
    set $lri_rails http://@RAILS_UPSTREAM@;
    proxy_pass $lri_rails;
  }

  location / {
    include /etc/nginx/lri/lri-zone-public.inc;
    proxy_read_timeout 300;
    set $lri_rails http://@RAILS_UPSTREAM@;
    proxy_pass $lri_rails;
    gzip on;
    gzip_types text/plain text/xml text/css image/svg+xml application/javascript application/json application/xml;
    gzip_proxied any;
  }
}

# ---------------------------------------------------------------------------------------------------------------
# ZONA INTERNA: atendimento.lri.com.br (o cloudflared só entrega depois de validar o JWT do Access)
# ---------------------------------------------------------------------------------------------------------------
server {
  listen 127.0.0.1:8082 default_server;
  server_name _;
  server_tokens off;
  return 404;
}

server {
  listen 127.0.0.1:8082;
  server_name @INTERNAL_HOST@;
  server_tokens off;

  # Caminho ambíguo (ver o map $lri_caminho_ambiguo): recusado antes de escolher a location.
  if ($lri_caminho_ambiguo) {
    return 400;
  }

  root /opt/zammad/public;
  access_log /dev/stdout;
  error_log  /dev/stdout;
  client_max_body_size @MAX_BODY@;

  location ~ ^/(assets/|robots.txt|humans.txt|favicon.ico|apple-touch-icon.png) {
    expires max;
  }

  # Monitor externo (docs/lri/GO-LIVE.md, seção 12): caminho só dele, com aplicativo próprio no Access (Service
  #   Auth), separado do /api/v1/monitoring que a tela de administração usa pelo navegador. Chega ao health check,
  #   que ainda exige o token de monitoramento do Zammad.
  #   O token segue ao Rails no cabeçalho validado (LriMonitorTokenMiddleware o passa ao health check) e nunca numa
  #   URL: requisição com query é recusada antes de ir ao upstream (o log de erro de uma falha grava a linha original
  #   da requisição), e a URL do upstream não tem query. Assim o log de erro fica no nível normal e a causa de um
  #   502/504 aparece sem expor a credencial.
  location = /lri-monitor/health_check {
    limit_except GET { deny all; }
    if ($args != "") { return 400; }
    include /etc/nginx/lri/lri-zone-internal.inc;
    proxy_set_header X-LRI-Monitor-Token $lri_monitor_token;
    access_log /dev/stdout lri_sem_query;
    proxy_read_timeout 30;
    set $lri_rails http://@RAILS_UPSTREAM@;
    proxy_pass $lri_rails/api/v1/monitoring/health_check;
  }

  # O Access casa o caminho do aplicativo do monitor por prefixo e sem diferenciar maiúsculas, então um subcaminho
  #   com a credencial do monitor também chega aqui. Só o caminho exato acima serve; o resto do prefixo, em qualquer
  #   caixa, para no Nginx (404) sem ir ao Rails. A recusa do caminho ambíguo, no começo do server, impede que o
  #   prefixo seja escondido por codificação.
  location ~* ^/lri-monitor(/|$) {
    return 404;
  }

  location /ws {
    include /etc/nginx/lri/lri-zone-internal.inc;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_set_header Origin $lri_internal_ws_origin;
    proxy_read_timeout 86400;
    set $lri_websocket http://@WEBSOCKET_UPSTREAM@;
    proxy_pass $lri_websocket;
  }

  location /cable {
    include /etc/nginx/lri/lri-zone-internal.inc;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_read_timeout 86400;
    set $lri_rails http://@RAILS_UPSTREAM@;
    proxy_pass $lri_rails;
  }

  location / {
    include /etc/nginx/lri/lri-zone-internal.inc;
    proxy_read_timeout 300;
    set $lri_rails http://@RAILS_UPSTREAM@;
    proxy_pass $lri_rails;
    gzip on;
    gzip_types text/plain text/xml text/css image/svg+xml application/javascript application/json application/xml;
    gzip_proxied any;
  }
}
